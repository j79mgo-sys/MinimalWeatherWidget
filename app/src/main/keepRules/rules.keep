# Keep all project classes to prevent R8 stripping/obfuscation issues with JSON parsing and UI data
-keep class com.jmgo.minimalweatherwidget.** { *; }
-keepclassmembers class com.jmgo.minimalweatherwidget.** { *; }

# Keep Android components (Activities, Receivers, Services, Providers)
-keep public class * extends android.app.Activity
-keep public class * extends android.app.Service
-keep public class * extends android.content.BroadcastReceiver
-keep public class * extends android.content.ContentProvider
-keep public class * extends android.appwidget.AppWidgetProvider

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="130dp"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:weightSum="4">

    <!-- COLUMNA 0 DE LA FILA -->
    <LinearLayout
        android:id="@+id/card0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:minHeight="130dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- Fila Día + Cámara + Icono -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/day0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="L"
                    android:textColor="#D69E2E"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cam0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="📷"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/icon0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:includeFontPadding="false"
                android:text="☀️"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- Viento -->
        <TextView
            android:id="@+id/wind0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="↗ 15"
            android:textColor="#4A5568"
            android:textSize="11sp" />

        <!-- Temperaturas -->
        <TextView
            android:id="@+id/temp0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="21 / 7"
            android:textColor="#1A202C"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Lluvia + UV -->
        <LinearLayout
            android:id="@+id/rainUvContainer0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rain0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="💧 1"
                android:textColor="#3182CE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/uvIcon0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="1dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="UV"
                    android:textColor="#DD6B20"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/uvStart0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="2-3"
                    android:textColor="#E53E3E"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Luz Útil / Deporte (Restauralo visible y legible) -->
        <TextView
            android:id="@+id/outdoor0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="🏃 5 h"
            android:textColor="#1A202C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>


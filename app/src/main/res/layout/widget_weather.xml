<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Cabecera Superior (22dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tvHeaderCityTemp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="📍 Medina Sidonia 23°"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUpdateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#A0AEC0"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- ListView ajustado a 106dp exactos (1:1 con la fila de 106dp) -->
    <ListView
        android:id="@+id/lvWidgetDays"
        android:layout_width="match_parent"
        android:layout_height="106dp"
        android:layout_gravity="center_vertical"
        android:clipToPadding="true"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <!-- Estado Fallback de Carga por si la lista está vacía -->
    <TextView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="106dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="Cargando previsión... Pulsa la hora para actualizar"
        android:textColor="#A0AEC0"
        android:textSize="11.5sp"
        android:visibility="gone" />

</LinearLayout>